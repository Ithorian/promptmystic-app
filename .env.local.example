# Supabase — from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Only needed for CLI operations like `supabase link` / migrations
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Stripe — from https://dashboard.stripe.com/apikeys (use Test Mode keys during development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
# From `stripe listen` output, or the webhook endpoint signing secret in the dashboard
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Anthropic — from https://console.anthropic.com/settings/keys (powers the PromptMystic engine)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
